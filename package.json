{
  "name": "sovereign-draft",
  "private": false,
  "version": "1.8.0",
  "description": "Issued 2D, touchable 3D, free. One plan becomes a documented building: model, stack, roof with valleys, dormers, drawing set on numbered sheets, takeoff. Exact mesh CSG, push-pull, DXF/DWG out.",
  "type": "module",
  "main": "./src/api.js",
  "exports": {
    ".": "./src/api.js",
    "./embed": "./src/embed.js"
  },
  "bin": {
    "sovereign-draft": "./bin/sovereign-draft.js"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/matpcul-tech/Sovereign-draft.git"
  },
  "homepage": "https://github.com/matpcul-tech/Sovereign-draft",
  "bugs": {
    "url": "https://github.com/matpcul-tech/Sovereign-draft/issues"
  },
  "files": [
    "src",
    "bin",
    "examples",
    "index.html",
    "embed.html",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "draft": "node bin/sovereign-draft.js",
    "examples": "node scripts/write-examples.mjs",
    "smoke": "node scripts/smoke.mjs",
    "accept": "node scripts/acceptance.mjs",
    "handoff": "node scripts/handoff.mjs",
    "job": "node scripts/job.mjs",
    "share:browser": "node scripts/share-browser.mjs",
    "asset:browser": "node scripts/asset-browser.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.71.0",
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@jsquash/webp": "^1.5.0",
    "fix-webm-duration": "^1.0.6",
    "gltf-validator": "^2.0.0-dev.3.10",
    "jpeg-js": "^0.4.4",
    "meshoptimizer": "^1.3.0",
    "pako": "^2.1.0",
    "three": "^0.185.1",
    "three-bvh-csg": "^0.0.18"
  },
  "devDependencies": {
    "playwright-core": "^1.62.1",
    "vite": "^7.3.0",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "^4.0.18"
  }
}
